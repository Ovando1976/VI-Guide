NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Use either the JSON value or the three individual Admin values.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMMERCE_WEBHOOK_SECRET=

# Transactional booking email delivery.
# The sender must be an email or a verified Resend identity, for example:
# VI Guide <bookings@your-verified-domain.com>
RESEND_API_KEY=
VI_GUIDE_EMAIL_FROM=
# Comma-separated internal recipients for booking and financial alerts.
VI_GUIDE_OPERATIONS_EMAILS=
# Canonical HTTPS origin used in email links.
VI_GUIDE_APP_URL=https://vi-guide.vercel.app
# Use a strong random secret of at least 16 characters for Vercel Cron authentication.
CRON_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Advisory multi-agent workers are OFF by default. When enabled they remain
# shadow-only: no worker receives direct model tool calls or mutation authority.
USVI_AGENT_WORKERS_SHADOW=0
# Deterministic read-only evidence broker. It only wraps explicitly allowlisted
# local read adapters and never grants write/execute/booking authority.
USVI_AGENT_TOOL_BROKER_SHADOW=0
# Preview/development-only canary master gate. Production is denied in code even
# if this is accidentally enabled there.
USVI_AGENT_SHADOW_CANARY=0
# Deterministic session sampling in basis points (0-10000). Defaults to zero so
# enabling the canary flag alone cannot spend model tokens.
USVI_AGENT_SHADOW_CANARY_SAMPLE_BPS=0
# Optional comma-separated SHA-256 hashes of preview session IDs for an explicit
# canary cohort. Raw session IDs must never be stored here.
USVI_AGENT_SHADOW_CANARY_SESSION_HASHES=

# Cruise inventory defaults to disabled and fails closed.
# Allowed providers: disabled, mock, traveltek, revelex.
CRUISE_INVENTORY_PROVIDER=disabled

# Synthetic inventory is only permitted in development or preview.
CRUISE_INVENTORY_ENABLE_MOCK=false

# External-provider controls. These flags do not bypass the requirement for a
# reviewed provider adapter in source code.
CRUISE_INVENTORY_CONTRACT_APPROVED=false
CRUISE_INVENTORY_ADAPTER_ENABLED=false
CRUISE_INVENTORY_PRODUCTION_CERTIFIED=false
CRUISE_INVENTORY_LIVE_ENABLED=false

TRAVELTEK_API_BASE_URL=
TRAVELTEK_API_KEY=
TRAVELTEK_AGENCY_ID=

REVELEX_API_BASE_URL=
REVELEX_API_KEY=
REVELEX_AGENCY_ID=
