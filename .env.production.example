NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=sk_live_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_COMMERCE_WEBHOOK_SECRET=whsec_replace_me
# Whole-number basis points. Example: 1000 = 10.00%. Blank or invalid values record a zero-fee unconfigured policy.
VI_GUIDE_COMMERCE_PLATFORM_FEE_BPS=
RESEND_API_KEY=re_replace_me
VI_GUIDE_EMAIL_FROM="VI Guide <bookings@your-domain.example>"
VI_GUIDE_OPERATIONS_EMAILS=operations@your-domain.example
VI_GUIDE_APP_URL=https://your-domain.example
CRON_SECRET=replace_with_at_least_32_random_characters
SUPPORT_EMAIL=
SUPPORT_PHONE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Keep disabled until the bounded-agent review gate is complete. Even when set
# to 1, workers run only in advisory shadow mode and receive no direct model tools.
USVI_AGENT_WORKERS_SHADOW=0
# Keep the deterministic local read-only broker disabled until its separate
# review gate is green. This does not grant write/execute/booking authority.
USVI_AGENT_TOOL_BROKER_SHADOW=0
# The first live-model canary is preview/development-only and production is
# categorically denied in code. Keep all canary controls at zero in production.
USVI_AGENT_SHADOW_CANARY=0
USVI_AGENT_SHADOW_CANARY_SAMPLE_BPS=0
USVI_AGENT_SHADOW_CANARY_SESSION_HASHES=
