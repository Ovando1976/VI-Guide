rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isPartner() {
      return signedIn() && (
        request.auth.token.partner == true ||
        request.auth.token.admin == true
      );
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /checkoutSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /roleAssignments/{userId} {
      allow read, write: if isAdmin();
    }

    match /partnerClaims/{claimId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /merchantLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mobilityRequests/{requestId} {
      allow create: if true;
      allow read, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /mobilityDispatchEvents/{eventId} {
      allow create: if isAdmin() || isPartner();
      allow read: if isAdmin() || isPartner();
      allow update, delete: if isAdmin();
    }

    match /bookingRequests/{requestId} {
      allow create: if true;
      allow read, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /partnerPages/{partnerPageId} {
      allow read: if true;
      allow create, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /partnerPageChangeRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }


    // ------------------------------------------------------------
    // VI Connect
    // Dating / friendship / social layer
    // ------------------------------------------------------------

    match /connectProfiles/{userId} {
      // MVP: signed-in users can discover visible profiles.
      // Owners and admins can read their own profile even if hidden.
      allow read: if signedIn() && (
        resource.data.isVisible == true ||
        isSelf(userId) ||
        isAdmin()
      );

      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if isSelf(userId) || isAdmin();
    }

    match /connectEngagement/{userId} {
      allow read, create, update, delete: if isSelf(userId) || isAdmin();
    }

    match /connectLikes/{likeId} {
      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toProfileId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /connectPasses/{passId} {
      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow read, delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /connectBlocks/{blockId} {
      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow read, delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /connectReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;

      // Reports should only be readable/moderated by admins.
      allow read, update, delete: if isAdmin();
    }


    match /connectConversations/{conversationId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantUids || isAdmin());

      allow create: if signedIn()
        && (request.auth.uid in request.resource.data.participantUids || isAdmin());

      allow update: if signedIn()
        && (request.auth.uid in resource.data.participantUids || isAdmin());

      allow delete: if signedIn()
        && (request.auth.uid in resource.data.participantUids || isAdmin());

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            request.auth.uid in get(/databases/$(database)/documents/connectConversations/$(conversationId)).data.participantUids
            || isAdmin()
          );

        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && (
            request.auth.uid in get(/databases/$(database)/documents/connectConversations/$(conversationId)).data.participantUids
            || isAdmin()
          );

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
