rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isPartner() {
      return signedIn() && (
        request.auth.token.partner == true ||
        request.auth.token.admin == true
      );
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /checkoutSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /roleAssignments/{userId} {
      allow read, write: if isAdmin();
    }

    match /partnerClaims/{claimId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /merchantLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mobilityRequests/{requestId} {
      allow create: if true;
      allow read, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /mobilityDispatchEvents/{eventId} {
      allow create: if isAdmin() || isPartner();
      allow read: if isAdmin() || isPartner();
      allow update, delete: if isAdmin();
    }

    match /bookingRequests/{requestId} {
      allow create: if true;
      allow read, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /partnerPages/{partnerPageId} {
      allow read: if true;
      allow create, update: if isAdmin() || isPartner();
      allow delete: if isAdmin();
    }

    match /partnerPageChangeRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
