rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /mobilityTripRequests/{requestId} {
      allow create: if isValidMobilityTripRequest();
      allow read, update, delete: if false;
    }

    function isValidMobilityTripRequest() {
      return request.resource.data.keys().hasAll([
        "draftId",
        "status",
        "pickupPlaceId",
        "dropoffPlaceId",
        "pickupName",
        "dropoffName",
        "pickupIsland",
        "dropoffIsland",
        "passengers",
        "luggage",
        "serviceClass",
        "totalFareCents",
        "taxiFareCents",
        "ferryFareCents",
        "connectorLabel",
        "routeDescription",
        "sourceLabel",
        "confidence",
        "lineItems",
        "notes",
        "requestedAt",
        "updatedAt",
        "firestoreSchemaVersion",
        "firebaseSource"
      ])
      && request.resource.data.status == "requested"
      && request.resource.data.firestoreSchemaVersion == 1
      && request.resource.data.firebaseSource == "mobility_page"
      && request.resource.data.passengers is int
      && request.resource.data.passengers >= 1
      && request.resource.data.passengers <= 12
      && request.resource.data.luggage is int
      && request.resource.data.luggage >= 0
      && request.resource.data.luggage <= 20
      && request.resource.data.totalFareCents is int
      && request.resource.data.totalFareCents >= 0
      && request.resource.data.serviceClass in ["shared", "private"]
      && request.resource.data.confidence in ["high", "medium", "low"];
    }
  }
}
