{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "merchant", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Island": {
      "title": "Island",
      "description": "Information about a specific island",
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "heroImage": { "type": "string" },
        "description": { "type": "string" },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer" }
      },
      "required": ["code", "name", "shortName", "featured", "sortOrder"]
    },
    "Area": {
      "title": "Area",
      "description": "A specific area or district on an island",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "kind": { "type": "string", "enum": ["town", "estate", "district", "beach_area", "harbor"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["slug", "name", "islandCode", "kind"]
    },
    "Beach": {
      "title": "Beach",
      "description": "Beach information",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "areaSlug": { "type": "string" },
        "description": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "coverImage": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "familyFriendly": { "type": "boolean" },
        "snorkeling": { "type": "boolean" },
        "foodNearby": { "type": "boolean" },
        "parkingInfo": { "type": "string" },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["slug", "name", "islandCode", "description", "latitude", "longitude", "coverImage", "createdAt", "updatedAt"]
    },
    "Place": {
      "title": "Place",
      "description": "Business or attraction",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["restaurant", "bar", "cafe", "shopping", "attraction", "nightlife", "excursion", "service"] },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "areaSlug": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "coverImage": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "hours": { "type": "object" },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["slug", "name", "category", "islandCode", "description", "createdAt", "updatedAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Local event",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "areaSlug": { "type": "string" },
        "description": { "type": "string" },
        "venueName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "coverImage": { "type": "string" },
        "startAt": { "type": "integer" },
        "endAt": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["slug", "title", "islandCode", "description", "startAt", "createdAt", "updatedAt"]
    },
    "FeaturedSection": {
      "title": "Featured Section",
      "description": "Curated sections for the home page",
      "type": "object",
      "properties": {
        "key": { "type": "string", "enum": ["home_hero", "featured_beaches", "top_food", "weekend_events"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "enabled": { "type": "boolean" },
        "itemRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "collection": { "type": "string", "enum": ["beaches", "places", "events"] },
              "slug": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "integer" }
      },
      "required": ["key", "title", "enabled", "itemRefs", "updatedAt"]
    },
    "AIDocument": {
      "title": "AI Document",
      "description": "AI-assisted document or report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["report", "proposal", "memo", "itinerary", "draft"] },
        "userId": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "estateSlug": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "sharedWith": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "content", "type", "userId", "version", "createdAt", "updatedAt"]
    },
    "CommunityPost": {
      "title": "Community Post",
      "description": "A geographically anchored community post",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "estateSlug": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "likes": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "userName", "content", "islandCode", "likes", "commentsCount", "createdAt", "updatedAt"]
    },
    "TransitRoute": {
      "title": "Transit Route",
      "description": "Information about a transit route",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ferry", "shuttle", "bus", "helicopter", "seaplane"] },
        "name": { "type": "string" },
        "operatorId": { "type": "string" },
        "islandCode": { "type": "string", "enum": ["st_thomas", "st_john", "st_croix", "water_island"] },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "schedule": { "type": "string" },
        "price": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "delayed", "cancelled"] },
        "lastUpdated": { "type": "integer" }
      },
      "required": ["type", "name", "operatorId", "islandCode", "from", "to", "status", "lastUpdated"]
    },
    "UserMemory": {
      "title": "User Memory",
      "description": "AI memory for a specific user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "object" },
        "importance": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "key", "value", "importance", "createdAt", "updatedAt"]
    },
    "CommunityComment": {
      "title": "Community Comment",
      "description": "A comment on a community post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["postId", "userId", "userName", "content", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A customer inquiry for a merchant",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "listingId": { "type": "string" },
        "listingName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "replied", "archived"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["merchantId", "listingId", "listingName", "userId", "userName", "userEmail", "message", "status", "createdAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Licensed driver profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "island": { "type": "string", "enum": ["stt", "stj", "stx"] },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "serviceModes": { "type": "array", "items": { "type": "string", "enum": ["airport", "town", "ferry", "shared", "private"] } },
        "vehicleType": { "type": "string", "enum": ["sedan", "suv", "van", "safari"] },
        "seats": { "type": "integer" },
        "luggageCapacity": { "type": "integer" },
        "licenseNumber": { "type": "string" },
        "taxiPermitNumber": { "type": "string" },
        "documents": {
          "type": "object",
          "properties": {
            "licenseVerified": { "type": "boolean" },
            "insuranceVerified": { "type": "boolean" },
            "registrationVerified": { "type": "boolean" }
          }
        },
        "payoutAccountConnected": { "type": "boolean" },
        "rating": { "type": "number" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "fullName", "phone", "island", "status", "serviceModes", "vehicleType", "seats", "licenseNumber", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Driver vehicle information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "driverId": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "color": { "type": "string" },
        "plate": { "type": "string" },
        "class": { "type": "string", "enum": ["standard", "premium", "shared"] },
        "island": { "type": "string", "enum": ["stt", "stj", "stx"] },
        "active": { "type": "boolean" }
      },
      "required": ["id", "driverId", "make", "model", "year", "plate", "class", "island", "active"]
    },
    "Trip": {
      "title": "Trip",
      "description": "A ride-sharing trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "riderId": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "quoted", "matched", "driver_en_route", "arrived", "in_progress", "ferry_leg", "completed", "cancelled"] },
        "tripType": { "type": "string", "enum": ["direct", "shared", "airport", "cruise", "ferry_transfer"] },
        "island": { "type": "string", "enum": ["stt", "stj", "stx", "multi"] },
        "pickup": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "type": { "type": "string", "enum": ["estate", "hotel", "beach", "airport", "ferry", "custom"] },
            "estateGeoid": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "dropoff": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "type": { "type": "string", "enum": ["estate", "hotel", "beach", "airport", "ferry", "custom"] },
            "estateGeoid": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "passengers": { "type": "integer" },
        "luggage": { "type": "integer" },
        "serviceClass": { "type": "string", "enum": ["private", "shared"] },
        "quote": {
          "type": "object",
          "properties": {
            "baseFare": { "type": "number" },
            "luggageFee": { "type": "number" },
            "waitingFee": { "type": "number" },
            "premiumFee": { "type": "number" },
            "total": { "type": "number" },
            "currency": { "type": "string" }
          }
        },
        "ferryPlan": {
          "type": "object",
          "properties": {
            "route": { "type": "string", "enum": ["red_hook_cruz_bay", "crown_bay_cruz_bay"] },
            "departureWindow": { "type": "string" },
            "leg1DriverId": { "type": "string" },
            "leg3DriverId": { "type": "string" }
          }
        },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "riderId", "status", "tripType", "island", "pickup", "dropoff", "passengers", "luggage", "serviceClass", "quote", "createdAt", "updatedAt"]
    },
    "FareRule": {
      "title": "Fare Rule",
      "description": "Pricing rules for trips",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "island": { "type": "string", "enum": ["stt", "stj", "stx", "multi"] },
        "serviceType": { "type": "string", "enum": ["standard", "private", "shared", "airport", "ferry_transfer"] },
        "originZone": { "type": "string" },
        "destinationZone": { "type": "string" },
        "pricingMode": { "type": "string", "enum": ["fixed", "per_person", "distance_plus_fixed"] },
        "baseAmount": { "type": "number" },
        "perPassengerAmount": { "type": "number" },
        "luggageAmount": { "type": "number" },
        "waitingPerMinute": { "type": "number" },
        "lateNightMultiplier": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "island", "serviceType", "originZone", "destinationZone", "pricingMode", "baseAmount", "active"]
    },
    "Partner": {
      "title": "Partner",
      "description": "B2B transport partner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["hotel", "villa_manager", "fleet", "excursion", "marina"] },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "name", "type", "contactEmail", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/islands/{islandId}": {
      "schema": "Island",
      "description": "Islands"
    },
    "/areas/{areaId}": {
      "schema": "Area",
      "description": "Areas"
    },
    "/beaches/{beachId}": {
      "schema": "Beach",
      "description": "Beaches"
    },
    "/places/{placeId}": {
      "schema": "Place",
      "description": "Places"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Events"
    },
    "/featured_sections/{sectionId}": {
      "schema": "FeaturedSection",
      "description": "Featured sections"
    },
    "/documents/{docId}": {
      "schema": "AIDocument",
      "description": "AI documents"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Community posts"
    },
    "/transit_routes/{routeId}": {
      "schema": "TransitRoute",
      "description": "Transit routes"
    },
    "/user_memories/{memoryId}": {
      "schema": "UserMemory",
      "description": "User memories"
    },
    "/community_comments/{commentId}": {
      "schema": "CommunityComment",
      "description": "Community post comments"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Customer inquiries"
    },
    "/mobility_drivers/{driverId}": {
      "schema": "Driver",
      "description": "Mobility drivers"
    },
    "/mobility_vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Mobility vehicles"
    },
    "/mobility_trips/{tripId}": {
      "schema": "Trip",
      "description": "Mobility trips"
    },
    "/mobility_fare_rules/{ruleId}": {
      "schema": "FareRule",
      "description": "Mobility fare rules"
    },
    "/mobility_partners/{partnerId}": {
      "schema": "Partner",
      "description": "Mobility partners"
    }
  }
}
