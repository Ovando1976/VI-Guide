# Copy to .env.sandbox and keep that file out of version control.
# The preflight command refuses live Stripe keys and production-like targets.

VI_GUIDE_COMMERCE_SANDBOX_CONFIRMATION=VI_GUIDE_COMMERCE_SANDBOX_ONLY

# Prefer a restricted Stripe test key with only the permissions required for
# Checkout Sessions, PaymentIntents, Refunds, Events, and Webhook Endpoints.
STRIPE_SECRET_KEY=rk_test_replace_with_sandbox_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_sandbox_key
STRIPE_COMMERCE_WEBHOOK_SECRET=whsec_replace_with_sandbox_or_stripe_cli_secret

# This must be a separate Firebase project whose ID explicitly contains
# sandbox, test, demo, or emulator. Both values must match exactly.
FIREBASE_PROJECT_ID=vi-guide-commerce-sandbox
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vi-guide-commerce-sandbox
VI_GUIDE_SANDBOX_FIREBASE_PROJECT_ID=vi-guide-commerce-sandbox

# Set these to the real production identifiers so the preflight can prove that
# the sandbox targets are different. Do not place production credentials here.
VI_GUIDE_PRODUCTION_FIREBASE_PROJECT_ID=replace_with_production_project_id
VI_GUIDE_PRODUCTION_APP_URL=https://vi-guide.vercel.app

# Localhost is accepted. A remote URL must use HTTPS and contain a sandbox/test
# marker in its hostname.
VI_GUIDE_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Whole-number basis points. 1000 = 10.00%.
VI_GUIDE_COMMERCE_PLATFORM_FEE_BPS=1000

# Isolated Firebase Admin credentials only. Never copy production credentials.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional sandbox notification settings. Use non-customer test inboxes only.
RESEND_API_KEY=
VI_GUIDE_EMAIL_FROM="VI Guide Sandbox <sandbox@example.test>"
VI_GUIDE_OPERATIONS_EMAILS=sandbox-operations@example.test
