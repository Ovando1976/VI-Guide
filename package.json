    "photos:audit": "tsx scripts/audit-google-photo-availability.ts",
    "photos:reviewed": "tsx scripts/apply-reviewed-google-place-ids.ts",
    "photos:reviewed:apply": "tsx scripts/apply-reviewed-google-place-ids.ts --apply",
    "restaurants:discover": "tsx scripts/discover-usvi-restaurants.ts",
    "restaurants:discover:apply": "tsx scripts/discover-usvi-restaurants.ts --apply",
    "historic:export": "tsx scripts/export-historic-sites.ts",
